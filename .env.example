# Copia este archivo a .env y rellena lo que uses.
# Postgres (usuarios, sesiones y proyectos). En local: DATABASE_URL; con docker compose: FUTBOL_DB_PASSWORD
DATABASE_URL=postgres://futbol:CLAVE@127.0.0.1:5433/futbol
# FUTBOL_DB_PASSWORD=una-clave-larga-y-aleatoria

# Claude Code (obligatorio, uno de los dos): token de tu suscripción con `claude setup-token`, o una API key de console.anthropic.com
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Codex (motor predeterminado de Anime): API key de platform.openai.com
# CODEX_API_KEY=
# Modelo de Codex (Frontier: gpt-6-astra | Workhorse: gpt-6.1-sol | Fast: gpt-6-luna)
# CODEX_MODEL=gpt-6.1-sol
# Motor global: auto (Claude y, si falla, Codex) | claude | codex
# AI_ENGINE=codex

# Opcionales (también se pueden pegar desde la app)
# FISH_API_KEY=
# ELEVENLABS_API_KEY=
# BRAVE_API_KEY=

# Métricas privadas de YouTube para que Anime aprenda de retención y suscripciones.
# Habilita YouTube Analytics API y YouTube Data API v3 en el mismo proyecto.
# El asistente pide youtube.readonly y yt-analytics.readonly (solo lectura).
# Crea un cliente OAuth de escritorio en Google Cloud.
# Después de rellenar Client ID y Client Secret, ejecuta `npm run youtube-auth` una vez.
# YOUTUBE_ANALYTICS_CLIENT_ID=
# YOUTUBE_ANALYTICS_CLIENT_SECRET=
# YOUTUBE_ANALYTICS_REFRESH_TOKEN=  # lo guarda el asistente OAuth en .env

# Buffer (publicar en YouTube, TikTok y Facebook): Buffer → Settings → API → Personal Access
# BUFFER_API_KEY=

# Revisión por Telegram antes de publicar: bot de @BotFather y el chat del dueño (el único al que obedece)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
