# Copia este archivo a .env y rellena lo que uses.
# Claude Code (obligatorio, uno de los dos): token de tu suscripción con `claude setup-token`, o una API key de console.anthropic.com
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Codex (respaldo si Claude falla, opcional): API key de platform.openai.com
# CODEX_API_KEY=
# Motor: auto (Claude y, si falla, Codex) | claude | codex
# AI_ENGINE=auto

# Opcionales (también se pueden pegar desde la app)
# FISH_API_KEY=
# ELEVENLABS_API_KEY=
# BRAVE_API_KEY=
